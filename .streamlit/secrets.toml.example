# ------------------------------------------------------------------
# このファイルをコピーして「secrets.toml」という名前で保存し、
# 中身を本物の値に書き換えて使う。
#
#   .streamlit/secrets.toml.example   ← これは GitHub に上げていい（見本）
#   .streamlit/secrets.toml           ← 本物。絶対に GitHub に上げない
#
# .gitignore で secrets.toml は除外済みなので、普通に使えば事故らない。
# Streamlit Community Cloud に公開するときは、このファイルは上げずに、
# 管理画面の「Settings → Secrets」欄に同じ内容を貼り付ける。
# ------------------------------------------------------------------

# Discord の Webhook URL（サーバー設定 → 連携サービス → ウェブフック）
DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy"

# Gemini の APIキー（Google AI Studio で発行）
GEMINI_API_KEY = "AIzaSy..."


# 生徒のシークレットIDと表示名。生徒の人数だけ行を増やす。
# 左が生徒に伝えるID、右が Discord の報告に出る名前。
[students]
"usami-001" = "テスト生徒"
# "usami-002" = "たろう"
# "usami-003" = "はなこ"

# ------------------------------------------------------------------
# 入室の方式（2026-11〜）。Secrets の中身で自動的に切り替わる。
#   1. ID＋パスワード方式 … [room_members."ID"] に password がある（本番はこれ）
#   2. Google ログイン方式 … [auth] と [room_members] があり、password は無い
#   3. 塾生シークレットID方式 … 上のどちらも無い（[students]）
#
# ⚠️ [room_members] は子どものIDとパスワードなので、公開リポジトリには絶対に入れない
#    （このファイルは見本なので、下はすべて架空の値）。
# ------------------------------------------------------------------

# --- 1. ID＋パスワード方式 ---
# ID（メール形式でなくてもよい。大文字小文字は区別しない）。password は長いランダムな文字列にする
# （python3 -c 'import secrets;print(secrets.token_urlsafe(12))'）。
# since = 有効になる日（日割りなし・月初）。省略すると即日有効。
# until = 最後に使える日（体験用など）。省略すると期限なし。この日を過ぎると入れなくなる。
# 同じIDで5回続けて失敗すると10分ロックされ、Discord に通知が飛ぶ。退会したら、その生徒の行を消す。
[room_members."student1@example.com"]
name = "朝陽"
since = "2026-11-01"
# until = "2026-11-30"   # 体験用は、終了日を入れる
password = "ここに長いランダムな文字列"

# --- 2. Google ログイン方式（使うときだけ。password を書いた行があると、こちらは使われない） ---
# [auth]
# redirect_uri = "https://xxxxxxxx.streamlit.app/oauth2callback"  # Google Cloud の「承認済みのリダイレクト URI」と完全一致
# cookie_secret = "ランダムな長い文字列(python3 -c 'import secrets;print(secrets.token_hex(32))')"
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-xxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
