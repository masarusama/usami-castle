# ------------------------------------------------------------------
# このファイルをコピーして「secrets.toml」という名前で保存し、
# 中身を本物の値に書き換えて使う。
#
#   .streamlit/secrets.toml.example   ← これは GitHub に上げていい（見本）
#   .streamlit/secrets.toml           ← 本物。絶対に GitHub に上げない
#
# .gitignore で secrets.toml は除外済みなので、普通に使えば事故らない。
# Streamlit Community Cloud に公開するときは、このファイルは上げずに、
# 管理画面の「Settings → Secrets」欄に同じ内容を貼り付ける。
# ------------------------------------------------------------------

# Discord の Webhook URL（サーバー設定 → 連携サービス → ウェブフック）
DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy"

# Gemini の APIキー（Google AI Studio で発行）
GEMINI_API_KEY = "AIzaSy..."


# 生徒のシークレットIDと表示名。生徒の人数だけ行を増やす。
# 左が生徒に伝えるID、右が Discord の報告に出る名前。
[students]
"usami-001" = "テスト生徒"
# "usami-002" = "たろう"
# "usami-003" = "はなこ"

# ------------------------------------------------------------------
# Google ログイン方式（2026-11〜）。[auth] と [room_members] の「両方」があると有効になる。
# どちらかが無ければ、上の [students]（塾生シークレットID）方式のまま動く。
#
# ⚠️ [room_members] は子どものメールアドレスなので、公開リポジトリには絶対に入れない
#    （このファイルは見本なので、下はすべて架空の値）。
# ------------------------------------------------------------------
[auth]
# アプリの実URL + /oauth2callback。Google Cloud の「承認済みのリダイレクト URI」と完全一致させる
redirect_uri = "https://xxxxxxxx.streamlit.app/oauth2callback"
cookie_secret = "ランダムな長い文字列(python3 -c 'import secrets;print(secrets.token_hex(32))')"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# 入室できるGoogleアカウント。since = 有効になる日（日割りなし・月初）。省略すると即日有効
[room_members."student1@example.com"]
name = "朝陽"
since = "2026-11-01"
